{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-07-09/server.schema.json",
  "name": "io.github.henriquepe/lousa",
  "description": "A whiteboard where AI agents draw their explanations as hand-drawn animated diagrams",
  "repository": {
    "url": "https://github.com/henriquepe/lousa",
    "source": "github"
  },
  "version": "0.1.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "lousa",
      "version": "0.1.1",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "npx",
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}